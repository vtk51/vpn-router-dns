[Unit]
Description=Reconcile selective VPN routing for LAN and Debian host
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/stacks/vpn-router
ExecStart=/opt/stacks/vpn-router/scripts/apply-rules.sh
TimeoutStartSec=180
RemainAfterExit=no
